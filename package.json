{
  "name": "little-engineer",
  "version": "0.5.4",
  "private": true,
  "description": "A calm, offline train game for a four-year-old.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:sw": "node scripts/test-sw.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
